import std;
import mcpp;
import mcpp.rules.qt;
import mcpp.rules.qml;

static std::string ensureQtSdkView()
{
    namespace fs = std::filesystem;
    const fs::path base = fs::path(mcpp::manifest_dir()) / "target" / ".qt-root";
    const std::string root = base.generic_string();

    std::error_code ec;
    fs::create_directories(base / "bin", ec);
    fs::create_directories(base / "include", ec);

    auto linkDir = [](const fs::path &link, const std::string &target) {
        std::error_code ec2;
        if (fs::read_symlink(link, ec2).generic_string() == target)
            return; // 已指向目标
        if (fs::exists(link, ec2) || fs::is_symlink(link, ec2))
            fs::remove_all(link, ec2); // remove_all 对符号链接只删链接本身
        fs::create_directory_symlink(target, link, ec2);
    };

    for (const char *t : { "moc", "rcc", "uic", "qmlcachegen",
                           "qmltyperegistrar", "qmlimportscanner", "qmllint" }) {
        const fs::path tool = fs::path("/usr/lib/qt6") / t;
        if (!fs::exists(tool, ec))
            continue;
        const fs::path link = base / "bin" / t;
        if (fs::read_symlink(link, ec).generic_string() == tool.generic_string())
            continue;
        fs::remove_all(link, ec);
        fs::create_symlink(tool, link, ec);
    }

    // 头文件：模块目录整体链接。
    for (fs::directory_iterator it("/usr/include/qt6", ec), end; it != end; it.increment(ec)) {
        const std::string name = it->path().filename().string();
        if (name.starts_with("Qt"))
            linkDir(base / "include" / name, it->path().generic_string());
    }

    linkDir(base / "lib", "/usr/lib");
    linkDir(base / "qml", "/usr/lib/qt6/qml");
    if (fs::exists("/usr/lib/qt6/plugins", ec))
        linkDir(base / "plugins", "/usr/lib/qt6/plugins");

    if (!fs::exists(base / "bin" / "moc", ec))
        mcpp::warning("qt sdk view: /usr/lib/qt6/moc not found; Qt6 tool layout unexpected");
    return root;
}

int main() {
    namespace qml = mcpp::rules::qml;
    qml::options o;

    o.qt.modules = { "Core", "Gui", "Network", "Qml", "Quick", "QuickControls2", "Concurrent" };
    o.qt.deploy_plugins = { "platforms", "imageformats" };
    o.qt.moc = mcpp::rules::qt::moc_scan::listed;
    o.qt.moc_headers = {
        "include/gallery/core/appearance.h",
        "include/gallery/core/cachecontroller.h",
        "include/gallery/core/photomodel.h",
    };
    if (const char *env = std::getenv("QT_ROOT_DIR")) {
        o.qt.root = env;
    } else if (std::filesystem::exists("/usr/lib/qt6/moc")) {
        o.qt.root = ensureQtSdkView();
    } else {
        o.qt.root = "/usr";
    }
    if (std::filesystem::exists(o.qt.root + "/../include/qt6"))
        mcpp::include_dir((o.qt.root + "/../include/qt6").c_str());
    // 宿主库目录：Qt 的传递依赖（glib/curl/duktape）住在这里。
    // 声明给引擎后 mcpp run 的加载路径与 mcpp pack 的闭包收集都能解析。
    if (std::filesystem::exists("/usr/lib"))
        mcpp::runtime_search_dir("/usr/lib");

    // ── Gallery QML 模块 ──
    qml::qml_module gallery;
    gallery.uri     = "Gallery";
    gallery.version = "1.0";
    gallery.root    = "qml";
    gallery.sources = { "qml/**/*.qml" };
    o.styles = { "Basic" };  // main.cpp 固定 QQuickStyle::setStyle("Basic")，只部署 Basic 样式
    o.modules = { gallery };

    return qml::compile(o) ? 0 : 1;
}
